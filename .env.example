# Envio del formulario de contacto (Resend).
# Sin estas tres variables el formulario valida y responde, pero no envia:
# devuelve un error generico y lo registra en el log del servidor.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Emmvi <sales@emmvi.com>"
CONTACT_FROM_EMAIL=
# Destinatario interno de las consultas
CONTACT_TO_EMAIL=

# Pagina de espera. Con COMING_SOON=1 la raiz sirve /coming-soon mediante
# rewrite (la URL sigue siendo la raiz). Quitarla devuelve la home completa.
COMING_SOON=

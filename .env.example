# Envio del formulario de contacto (Resend).
# Sin estas tres variables el formulario valida y responde, pero no envia:
# devuelve un error generico y lo registra en el log del servidor.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Emmvi <sales@emmvi.com>"
CONTACT_FROM_EMAIL=
# Destinatario interno de las consultas
# Uno o varios, separados por comas: sales@emmvi.com, nico@emmvi.com
CONTACT_TO_EMAIL=

# Pagina de espera. Con COMING_SOON=1 la raiz sirve la pantalla de espera en
# vez de la home (la URL sigue siendo la raiz; se resuelve en build, sin
# rewrite ni middleware). Quitarla devuelve la home completa.
#
# NO toca el buscador: el sitio se indexa igual con la espera puesta, porque
# hay URLs del WordPress anterior en el indice y cerrarlo las perderia.
COMING_SOON=

# PostHog: analitica de producto y grabacion de sesion. Las dos son publicas
# (viajan al navegador), pero el asistente las escribio en .env, que esta en
# .gitignore y no se despliega: **hay que copiarlas a mano en Vercel**
# (Settings -> Environment Variables) o PostHog no medira nada en produccion.
#
# El host tiene que ser el europeo. La politica de privacidad promete que la
# analitica no sale de la UE; con el host de EE. UU. esa frase es falsa.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Aviso a Slack de cada consulta (Incoming Webhook). Opcional: sin esto el
# formulario funciona igual y no avisa a nadie. Slack -> Apps -> crear una app
# -> Incoming Webhooks -> Add New Webhook to Workspace -> elegir el canal.
SLACK_WEBHOOK_URL=
